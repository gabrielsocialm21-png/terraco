{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/brand/**",
              "components/chrome/**",
              "components/social/**",
              "ui_kits/instagram/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Archivo|Raleway|Montserrat))/i]",
        "message": "Font not provided by the design system. Available: Archivo, Raleway, Montserrat."
      },
      {
        "selector": "JSXOpeningElement[name.name='AccountType'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|style|key|ref|className|style|children)$/]",
        "message": "<AccountType> doesn't accept that prop. Declared props: children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Camera'] > JSXAttribute > JSXIdentifier[name!=/^(?:size|color|style|key|ref|className|style|children)$/]",
        "message": "<Camera> doesn't accept that prop. Declared props: size, color, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='GrainCover'] > JSXAttribute > JSXIdentifier[name!=/^(?:texture|title|subtitle|align|ratio|radius|style|children|key|ref|className|style|children)$/]",
        "message": "<GrainCover> doesn't accept that prop. Declared props: texture, title, subtitle, align, ratio, radius, style, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='GrainCover'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:center|left)$/]",
        "message": "<GrainCover> align must be one of 'center' | 'left'."
      },
      {
        "selector": "JSXOpeningElement[name.name='HighlightCover'] > JSXAttribute > JSXIdentifier[name!=/^(?:src|label|size|onClick|style|key|ref|className|style|children)$/]",
        "message": "<HighlightCover> doesn't accept that prop. Declared props: src, label, size, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='HomeIndicator'] > JSXAttribute > JSXIdentifier[name!=/^(?:color|style|key|ref|className|style|children)$/]",
        "message": "<HomeIndicator> doesn't accept that prop. Declared props: color, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='IGButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|children|icon|onClick|style|key|ref|className|style|children)$/]",
        "message": "<IGButton> doesn't accept that prop. Declared props: variant, children, icon, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='IGButton'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:follow|following|neutral|outline)$/]",
        "message": "<IGButton> variant must be one of 'follow' | 'following' | 'neutral' | 'outline'."
      },
      {
        "selector": "JSXOpeningElement[name.name='IGTabBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:avatar|active|style|key|ref|className|style|children)$/]",
        "message": "<IGTabBar> doesn't accept that prop. Declared props: avatar, active, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='IGTabBar'] > JSXAttribute[name.name='active'] > Literal[value!=/^(?:home|search|add|activity|profile)$/]",
        "message": "<IGTabBar> active must be one of 'home' | 'search' | 'add' | 'activity' | 'profile'."
      },
      {
        "selector": "JSXOpeningElement[name.name='InformacoesLayout'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|topic|page|brand|copyright|inset|style|key|ref|className|style|children)$/]",
        "message": "<InformacoesLayout> doesn't accept that prop. Declared props: tone, topic, page, brand, copyright, inset, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='InformacoesLayout'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:dark|light)$/]",
        "message": "<InformacoesLayout> tone must be one of 'dark' | 'light'."
      },
      {
        "selector": "JSXOpeningElement[name.name='InstagramHighlightIcons'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|src|label|size|onClick|style|key|ref|className|style|children)$/]",
        "message": "<InstagramHighlightIcons> doesn't accept that prop. Declared props: icon, src, label, size, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='InstagramHighlightIcons'] > JSXAttribute[name.name='icon'] > Literal[value!=/^(?:01|02)$/]",
        "message": "<InstagramHighlightIcons> icon must be one of '01' | '02'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Logo'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|tone|basePath|height|alt|style|key|ref|className|style|children)$/]",
        "message": "<Logo> doesn't accept that prop. Declared props: variant, tone, basePath, height, alt, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Logo'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:symbol|horizontal|horizontal-descriptor|vertical)$/]",
        "message": "<Logo> variant must be one of 'symbol' | 'horizontal' | 'horizontal-descriptor' | 'vertical'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Logo'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:dark|light)$/]",
        "message": "<Logo> tone must be one of 'dark' | 'light'."
      },
      {
        "selector": "JSXOpeningElement[name.name='PerfilStory'] > JSXAttribute > JSXIdentifier[name!=/^(?:tipo|src|size|label|onClick|style|key|ref|className|style|children)$/]",
        "message": "<PerfilStory> doesn't accept that prop. Declared props: tipo, src, size, label, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='PerfilStory'] > JSXAttribute[name.name='tipo'] > Literal[value!=/^(?:porVer|visto|seguir)$/]",
        "message": "<PerfilStory> tipo must be one of 'porVer' | 'visto' | 'seguir'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProfileName'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|style|key|ref|className|style|children)$/]",
        "message": "<ProfileName> doesn't accept that prop. Declared props: children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProfileStat'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|label|style|key|ref|className|style|children)$/]",
        "message": "<ProfileStat> doesn't accept that prop. Declared props: value, label, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Seguir'] > JSXAttribute > JSXIdentifier[name!=/^(?:seguindo|children|onClick|style|key|ref|className|style|children)$/]",
        "message": "<Seguir> doesn't accept that prop. Declared props: seguindo, children, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatusBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:time|color|style|key|ref|className|style|children)$/]",
        "message": "<StatusBar> doesn't accept that prop. Declared props: time, color, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='StoryAvatar'] > JSXAttribute > JSXIdentifier[name!=/^(?:src|alt|size|ring|label|onClick|style|key|ref|className|style|children)$/]",
        "message": "<StoryAvatar> doesn't accept that prop. Declared props: src, alt, size, ring, label, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='StoryAvatar'] > JSXAttribute[name.name='ring'] > Literal[value!=/^(?:unseen|seen|none)$/]",
        "message": "<StoryAvatar> ring must be one of 'unseen' | 'seen' | 'none'."
      },
      {
        "selector": "JSXOpeningElement[name.name='UserName'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|style|key|ref|className|style|children)$/]",
        "message": "<UserName> doesn't accept that prop. Declared props: children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='VerificadoPagina'] > JSXAttribute > JSXIdentifier[name!=/^(?:nome|verificado|size|style|key|ref|className|style|children)$/]",
        "message": "<VerificadoPagina> doesn't accept that prop. Declared props: nome, verificado, size, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='VerifiedBadge'] > JSXAttribute > JSXIdentifier[name!=/^(?:size|color|style|key|ref|className|style|children)$/]",
        "message": "<VerifiedBadge> doesn't accept that prop. Declared props: size, color, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Website'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|href|style|key|ref|className|style|children)$/]",
        "message": "<Website> doesn't accept that prop. Declared props: children, href, style."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
